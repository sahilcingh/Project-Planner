# Postgres connection string (Supabase: Project Settings > Database > Connection string)
DATABASE_URL=

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local in-process model (transformers.js), used for stack-advisor rationale
# generation (no key/account needed). Downloads once from Hugging Face on
# first use, then runs fully offline. Defaults to onnx-community/Qwen2.5-0.5B-Instruct.
LOCAL_MODEL=
